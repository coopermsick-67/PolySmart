{% liquid
  assign library_collection = section.settings.library_collection
  if library_collection == blank
    assign library_collection = collections['the-agency-fieldnotes-library']
  endif

  assign bundle_product = all_products['ai-agency-launch-kit-complete-bundle']
  assign bundle_url = '/products/ai-agency-launch-kit-complete-bundle'
  assign bundle_price = '$59'
  assign bundle_cents = 5900
  assign checkout_url = bundle_url
  if bundle_product != blank
    assign bundle_url = bundle_product.url
    assign checkout_url = bundle_product.url
    assign bundle_price = bundle_product.price | money_without_trailing_zeros
    assign bundle_cents = bundle_product.price
    if bundle_product.available
      assign checkout_url = '/cart/' | append: bundle_product.selected_or_first_available_variant.id | append: ':1'
    endif
  endif

  comment
    Savings only show when all 7 individual resources are actually for sale,
    so the 'bought separately' price is one a buyer can really pay.
  endcomment
  assign sep_total = 0
  assign sep_count = 0
  if library_collection != blank
    for p in library_collection.products
      if p.handle != 'ai-agency-launch-kit-complete-bundle' and p.available
        assign sep_total = sep_total | plus: p.price
        assign sep_count = sep_count | plus: 1
      endif
    endfor
  endif
  assign show_savings = false
  if sep_count >= 7 and sep_total > bundle_cents
    assign show_savings = true
    assign save_cents = sep_total | minus: bundle_cents
    assign save_pct = save_cents | times: 100 | divided_by: sep_total
    assign sep_money = sep_total | money_without_trailing_zeros
    assign save_money = save_cents | money_without_trailing_zeros
  endif
%}
