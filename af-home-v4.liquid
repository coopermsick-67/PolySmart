{% style %}
  {{ r }} { --ink: #161815; --muted: #666b64; --paper: #f7f4ee; --paper-2: #efe9df; --wine: #651d32; --wine-dark: #3c101e; --rose: #d98da0; --line: #ded8ce; --white: #fffdfa; background: var(--white); color: var(--ink); font-family: var(--font-body--family, Inter, system-ui, sans-serif); font-size: 16px; line-height: 1.55; }
  body:has({{ r }}) .shopify-section-group-header-group, body:has({{ r }}) .shopify-section-group-footer-group { display: none !important; }
  {{ r }} *, {{ r }} *::before, {{ r }} *::after { box-sizing: border-box; }
  {{ r }} a { color: inherit; }
  {{ r }} img { display: block; width: 100%; height: auto; }
  {{ r }} h1, {{ r }} h2, {{ r }} h3, {{ r }} p { margin-top: 0; }
  {{ r }} .af2-wrap { width: min(1180px, calc(100% - 40px)); margin: 0 auto; }
  {{ r }} .af2-skip { position: fixed; z-index: 100; top: -80px; left: 16px; padding: 10px 14px; background: var(--ink); color: #fff; border-radius: 8px; }
  {{ r }} .af2-skip:focus { top: 12px; }
  {{ r }} .af2-offerbar { background: var(--ink); color: #fff; }
  {{ r }} .af2-offerbar-inner { min-height: 34px; display: flex; align-items: center; justify-content: center; gap: 9px; font-size: .72rem; letter-spacing: .02em; }
  {{ r }} .af2-offerbar strong { color: #ffd8e2; }
  {{ r }} .af2-dot { opacity: .45; }
  {{ r }} .af2-header { min-height: 76px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 28px; border-bottom: 1px solid var(--line); }
  {{ r }} .af2-brand { display: inline-flex; align-items: center; text-decoration: none; }
  {{ r }} img.af2-logo { width: auto; height: 36px; }
  {{ r }} .af2-nav { justify-self: center; display: flex; gap: 28px; }
  {{ r }} .af2-nav a, {{ r }} .af2-cart { text-decoration: none; font-size: .78rem; font-weight: 700; }
  {{ r }} .af2-nav a:hover, {{ r }} .af2-cart:hover { color: var(--wine); }
  {{ r }} .af2-kicker { margin-bottom: 14px; color: var(--wine); font-size: .68rem; font-weight: 900; letter-spacing: .17em; text-transform: uppercase; }
  {{ r }} .af2-hero { display: grid; grid-template-columns: 1.02fr .98fr; gap: clamp(42px, 7vw, 88px); align-items: center; min-height: 690px; padding: 72px 0 66px; }
  {{ r }} .af2-hero-copy { max-width: 610px; }
  {{ r }} .af2-hero h1 { margin-bottom: 22px; font-size: clamp(3rem, 6vw, 5.6rem); line-height: .94; letter-spacing: -.06em; font-weight: 850; }
  {{ r }} .af2-lead { max-width: 560px; margin-bottom: 28px; color: var(--muted); font-size: clamp(1rem, 1.5vw, 1.18rem); line-height: 1.7; }
  {{ r }} .af2-cta-row { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  {{ r }} .af2-btn { min-height: 54px; display: inline-flex; align-items: center; justify-content: center; padding: 13px 20px; border: 1px solid transparent; border-radius: 11px; text-decoration: none; font: inherit; font-size: .86rem; font-weight: 800; cursor: pointer; transition: transform .2s ease, background .2s ease, border-color .2s ease; }
  {{ r }} .af2-btn:hover { transform: translateY(-2px); }
  {{ r }} .af2-btn-primary { background: var(--wine); color: #fff; }
  {{ r }} .af2-btn-primary:hover { background: var(--wine-dark); }
  {{ r }} .af2-btn-secondary { border-color: var(--line); background: var(--white); }
  {{ r }} .af2-btn-secondary:hover { border-color: var(--ink); }
  {{ r }} .af2-btn-block { width: 100%; }
